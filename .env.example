# URL publique du site (canonical, sitemap, Open Graph). Exemple : https://www.votre-domaine.fr
PUBLIC_SITE_URL=

# Endpoint qui recoit le formulaire de contact et la newsletter (Formspree, Getform, Netlify, API maison).
# Vide : le succes est simule en developpement, et l'envoi echoue proprement en production.
PUBLIC_FORM_ENDPOINT=

# Lien de prise de rendez-vous (Calendly ou equivalent). Vide : le bouton "Reserver un creneau" est masque.
PUBLIC_BOOKING_URL=

# Domaine suivi par la mesure d'audience sans cookie (Plausible). Vide : mesure desactivee.
PUBLIC_ANALYTICS_DOMAIN=

# Optionnel : URL du script de mesure si auto-heberge. Par defaut https://plausible.io/js/script.js
PUBLIC_ANALYTICS_SRC=

# Mode demo : tant que la valeur n'est pas "0", les placeholders de contenu restants s'affichent en lorem ipsum et en
# faux chiffres, et le site est servi en noindex (balise meta et robots.txt). Mettre 0 pour publier avec le vrai contenu.
PUBLIC_DEMO_CONTENT=
