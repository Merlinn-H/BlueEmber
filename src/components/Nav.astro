---
import Logo from './Logo.astro';
import Button from './Button.astro';
import { site } from '../config/site';

const path = Astro.url.pathname.length > 1 ? Astro.url.pathname.replace(/\/$/, '') : '/';
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="nav" data-nav>
  <div class="nav__bar container">
    <a class="nav__logo" href="/" aria-label="Blue Ember agency, accueil">
      <Logo variant="dark" size={26} />
    </a>

    <nav class="nav__links" aria-label="Navigation principale">
      <ul>
        {
          site.nav.map((link) => (
            <li>
              <a class="nav__link" href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="nav__cta">
      <Button href={site.cta.href} variant="outline" size="sm">{site.cta.label}</Button>
    </div>

    <Button
      class="nav__toggle"
      variant="outline"
      size="sm"
      magnetic={false}
      aria-expanded="false"
      aria-controls="menu"
      data-menu-toggle
    >
      Menu
    </Button>
  </div>

  <!-- Full-screen menu (mobile) on the Ambiance background -->
  <div class="menu ambiance-surface" id="menu" data-menu hidden>
    <nav class="menu__nav" aria-label="Menu">
      <ul class="menu__list">
        {
          site.nav.map((link) => (
            <li>
              <a class="menu__link" href={link.href} data-menu-link aria-current={isActive(link.href) ? 'page' : undefined}>
                <span class="menu__link-inner">{link.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="menu__cta" data-menu-cta>
      <Button href={site.cta.href} variant="primary">{site.cta.label}</Button>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-nav);
    pointer-events: none;
  }

  /* Soft scrim that appears once the page has scrolled, so the transparent bar stays legible */
  .nav::before {
    content: '';
    position: absolute;
    inset: 0 0 -48px 0;
    background: linear-gradient(to bottom, rgba(14, 11, 10, 0.92) 0%, rgba(14, 11, 10, 0.78) 55%, rgba(14, 11, 10, 0));
    opacity: 0;
    transition: opacity var(--dur-mid) var(--ease-in-out);
  }

  .nav:global(.is-scrolled)::before {
    opacity: 1;
  }

  .nav__bar {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--nav-h);
    pointer-events: auto;
    transition: transform var(--dur-mid) var(--ease-in-out);
  }

  .nav:global(.is-hidden) .nav__bar {
    transform: translate3d(0, -110%, 0);
  }

  .nav__logo {
    justify-self: start;
    display: inline-flex;
    padding-block: var(--space-2);
  }

  .nav__links ul {
    display: flex;
    gap: var(--space-6);
  }

  .nav__link {
    position: relative;
    display: inline-block;
    padding-block: var(--space-2);
    font-size: var(--fs-button);
    line-height: var(--lh-button);
    color: var(--ink-muted);
    transition: color var(--dur-fast) var(--ease-out-expo);
  }

  /* Point flamme de 4px sous le lien : au survol, et en permanence sur la page active */
  .nav__link::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -2px;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: var(--flamme);
    opacity: 0;
    transform: scale(0.4);
    transition:
      opacity var(--dur-fast) var(--ease-out-expo),
      transform var(--dur-fast) var(--ease-out-expo);
  }

  .nav__link:hover,
  .nav__link[aria-current='page'] {
    color: var(--ink);
  }

  .nav__link:hover::after,
  .nav__link[aria-current='page']::after {
    opacity: 1;
    transform: none;
  }

  .nav__cta {
    justify-self: end;
  }

  .nav :global(.nav__toggle) {
    display: none;
    justify-self: end;
  }

  .menu {
    position: fixed;
    inset: 0;
    z-index: 1;
    display: grid;
    align-content: center;
    gap: var(--space-6);
    padding: calc(var(--nav-h) + var(--space-5)) var(--gutter) var(--space-7);
    overflow-y: auto;
    pointer-events: auto;
  }

  .menu[hidden] {
    display: none;
  }

  .menu__list {
    display: grid;
    gap: var(--space-2);
  }

  .menu__link {
    display: block;
    overflow: hidden;
    padding-block: 0.04em 0.1em;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 44px;
    line-height: 1.1;
  }

  .menu__link-inner {
    display: block;
  }

  .menu__link[aria-current='page'] .menu__link-inner::after {
    content: '.';
    color: var(--flamme);
  }

  @media (max-width: 899px) {
    .nav__bar {
      grid-template-columns: 1fr auto;
    }

    .nav__links,
    .nav__cta {
      display: none;
    }

    .nav :global(.nav__toggle) {
      display: inline-flex;
    }
  }

  /* Without JavaScript the full-screen menu cannot open: keep the links reachable */
  :global(html:not(.js)) .nav__links {
    display: block;
  }

  @media (max-width: 899px) {
    :global(html:not(.js)) .nav__links {
      display: block;
      grid-column: 1 / -1;
    }

    :global(html:not(.js)) .nav :global(.nav__toggle) {
      display: none;
    }

    :global(html:not(.js)) .nav__bar {
      height: auto;
      padding-bottom: var(--space-3);
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__bar,
    .nav::before {
      transition: none;
    }
  }
</style>
