---
import Icon from './Icon.astro';

interface Props {
  href?: string;
  variant?: 'primary' | 'outline' | 'link';
  size?: 'md' | 'sm';
  /** Arrow that slides 4px on hover. Defaults to true for the primary button. */
  arrow?: boolean;
  type?: 'button' | 'submit';
  /** Magnetic effect on desktop (the button follows the mouse by 6px at most). */
  magnetic?: boolean;
  class?: string;
  [attr: string]: unknown;
}

const { href, variant = 'primary', size = 'md', arrow, type = 'button', magnetic, class: className, ...rest } = Astro.props;
const showArrow = arrow ?? variant === 'primary';
const isMagnetic = magnetic ?? variant !== 'link';
const Tag = href ? 'a' : 'button';
const attrs = href ? { href, ...rest } : { type, ...rest };
---

<Tag class:list={['btn', `btn--${variant}`, size === 'sm' && 'btn--sm', className]} data-magnetic={isMagnetic ? '' : undefined} {...attrs}>
  <span class="btn__fill" aria-hidden="true"></span>
  <span class="btn__label"><slot /></span>
  {showArrow && <Icon name="arrow-right" class="btn__arrow" />}
</Tag>

<style>
  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    height: 48px;
    padding-inline: var(--space-5);
    border-radius: var(--radius-pill);
    font-family: var(--font-body);
    font-size: var(--fs-button);
    line-height: var(--lh-button);
    font-weight: 600;
    white-space: nowrap;
    isolation: isolate;
    -webkit-tap-highlight-color: transparent;
  }

  /* Hover fill lives on its own layer so only opacity is animated */
  .btn--sm {
    height: 40px;
    padding-inline: var(--space-4);
  }

  .btn__fill {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-out-expo);
  }

  .btn__arrow {
    transition: transform var(--dur-fast) var(--ease-out-expo);
  }

  /* Principal : ivoire, texte charbon, survol flamme */
  .btn--primary {
    background: var(--ivoire);
    color: var(--charbon);
  }

  .btn--primary .btn__fill {
    background: var(--flamme);
  }

  /* Contour : transparent, bordure line, survol ivoire */
  .btn--outline {
    border: 1px solid var(--line);
    color: var(--ink);
    transition: color var(--dur-fast) var(--ease-out-expo);
  }

  .btn--outline .btn__fill {
    background: var(--ivoire);
  }

  /* Lien : texte ink, soulignement flamme au survol */
  .btn--link {
    height: auto;
    padding: 0;
    border-radius: 0;
    color: var(--ink);
  }

  .btn--link .btn__fill {
    inset: auto 0 -4px 0;
    height: 2px;
    border-radius: 0;
    background: var(--flamme);
    opacity: 1;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-mid) var(--ease-out-expo);
  }

  .btn:disabled,
  .btn[aria-disabled='true'] {
    opacity: 0.55;
    pointer-events: none;
  }

  @media (hover: hover) {
    .btn:hover .btn__fill {
      opacity: 1;
    }

    .btn--link:hover .btn__fill {
      transform: scaleX(1);
    }

    .btn--outline:hover {
      color: var(--charbon);
    }

    .btn:hover .btn__arrow {
      transform: translateX(4px);
    }
  }

  .btn:focus-visible .btn__fill {
    opacity: 1;
  }

  .btn--link:focus-visible .btn__fill {
    transform: scaleX(1);
  }

  .btn--outline:focus-visible {
    color: var(--charbon);
  }

  /* Filter pills: the pressed one stays filled */
  .btn--outline[aria-pressed='true'] {
    color: var(--charbon);
  }

  .btn--outline[aria-pressed='true'] .btn__fill {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .btn__arrow,
    .btn--link .btn__fill {
      transition: none;
    }
  }
</style>
