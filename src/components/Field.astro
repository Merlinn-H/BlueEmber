---
// Form field: visible label, control, and an error line linked with aria-describedby.
// Validation messages are written by src/scripts/motion/form.ts.
interface Props {
  name: string;
  label: string;
  as?: 'input' | 'textarea' | 'select';
  type?: 'text' | 'email' | 'tel' | 'url' | 'number';
  required?: boolean;
  autocomplete?: string;
  options?: { value: string; label: string }[];
  rows?: number;
  id?: string;
  /** Message shown when the field is required and empty. */
  requiredMessage?: string;
  /** Message shown when the value has the wrong format. */
  invalidMessage?: string;
}

const {
  name,
  label,
  as = 'input',
  type = 'text',
  required = false,
  autocomplete,
  options = [],
  rows = 5,
  id = `f-${name}`,
  requiredMessage,
  invalidMessage,
} = Astro.props;
const errorId = `${id}-error`;
---

<div class="field" data-field data-required-message={requiredMessage} data-invalid-message={invalidMessage}>
  <label class="field__label" for={id}>
    {label}
    {required ? <span class="field__flag" aria-hidden="true"> *</span> : <span class="field__flag"> (facultatif)</span>}
  </label>
  {
    as === 'textarea' ? (
      <textarea class="field__control" id={id} name={name} rows={rows} required={required} aria-describedby={errorId} />
    ) : as === 'select' ? (
      <select class="field__control field__control--select" id={id} name={name} required={required} aria-describedby={errorId}>
        <option value="" disabled selected>
          Choisir
        </option>
        {options.map((option) => (
          <option value={option.value}>{option.label}</option>
        ))}
      </select>
    ) : (
      <input
        class="field__control"
        id={id}
        name={name}
        type={type}
        required={required}
        autocomplete={autocomplete}
        aria-describedby={errorId}
      />
    )
  }
  <p class="field__error t-small" id={errorId} data-error></p>
</div>

<style is:global>
  .field {
    display: grid;
    gap: var(--space-2);
  }

  .field__label {
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    font-weight: 600;
    color: var(--ink);
  }

  .field__flag {
    font-weight: 400;
    color: var(--ink-muted);
  }

  /* Champs : fond cendre, radius-sm, bordure line, focus focus */
  .field__control {
    width: 100%;
    min-height: 52px;
    padding: 14px var(--space-3);
    background: var(--surface-raised);
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-size: var(--fs-body);
    line-height: var(--lh-small);
    transition: border-color var(--dur-fast) var(--ease-out-expo);
  }

  textarea.field__control {
    min-height: 160px;
    resize: vertical;
  }

  .field__control--select {
    appearance: none;
    padding-right: var(--space-6);
    background-image:
      linear-gradient(45deg, transparent 50%, var(--titane-pale) 50%),
      linear-gradient(135deg, var(--titane-pale) 50%, transparent 50%);
    background-position:
      calc(100% - 22px) 50%,
      calc(100% - 16px) 50%;
    background-size: 6px 6px;
    background-repeat: no-repeat;
  }

  .field__control:hover {
    border-color: rgba(246, 238, 227, 0.3);
  }

  .field__control:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
    border-color: var(--focus);
  }

  .field__control[aria-invalid='true'] {
    border-color: var(--flamme);
  }

  .field__error {
    min-height: 0;
    color: var(--ivoire);
  }

  .field__error:not(:empty)::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: var(--space-2);
    border-radius: 50%;
    background: var(--flamme);
    vertical-align: middle;
  }

  /* Anti-spam honeypot: invisible to people, reachable by naive bots */
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .check {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: var(--space-3);
    align-items: start;
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--ink-muted);
  }

  .check input {
    width: 22px;
    height: 22px;
    margin: 0;
    accent-color: var(--flamme);
  }

  .form-status {
    min-height: 20px;
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--ink);
  }
</style>
