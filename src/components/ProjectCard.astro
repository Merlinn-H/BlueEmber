---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projets'>;
  loading?: 'lazy' | 'eager';
  level?: 'h2' | 'h3';
}

const { project, loading = 'lazy', level = 'h3' } = Astro.props;
const { title, client, year, cover, video } = project.data;
const Heading = level;
---

<article class="project-card" data-project-type={project.data.type}>
  <a class="project-card__link" href={`/realisations/${project.id}`} data-cursor="view">
    <div class="project-card__frame">
      <div class="project-card__media">
        <img src={cover} width="960" height="1200" alt="" loading={loading} decoding="async" draggable="false" />
        {
          video && (
            <video class="project-card__video" muted playsinline loop preload="none" poster={video.poster} data-hover-video>
              <source src={video.src} />
            </video>
          )
        }
      </div>
      <span class="project-card__shadow" aria-hidden="true"></span>
    </div>
    <Heading class="project-card__title t-h3">{title}</Heading>
    <p class="project-card__meta t-small t-muted">{client} · {year}</p>
  </a>
</article>

<style is:global>
  .project-card__link {
    display: block;
  }

  .project-card__frame {
    position: relative;
  }

  .project-card__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-none);
    background: var(--surface-raised);
  }

  .project-card__media img,
  .project-card__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-mid) var(--ease-out-expo);
  }

  .project-card__video {
    opacity: 0;
    transition:
      transform var(--dur-mid) var(--ease-out-expo),
      opacity var(--dur-mid) var(--ease-out-expo);
  }

  .project-card__video.is-playing {
    opacity: 1;
  }

  /* Soft lift shadow on its own layer: only opacity changes on hover */
  .project-card__shadow {
    position: absolute;
    inset: 0;
    z-index: -1;
    box-shadow: var(--shadow-lift);
    opacity: 0;
    transition: opacity var(--dur-mid) var(--ease-out-expo);
  }

  .project-card__title {
    margin-top: var(--space-4);
  }

  .project-card__meta {
    margin-top: var(--space-1);
  }

  .project-card {
    transition: opacity var(--dur-mid) var(--ease-out-expo);
  }

  @media (hover: hover) {
    .project-card__link:hover img,
    .project-card__link:hover .project-card__video {
      transform: scale(1.06);
    }

    .project-card__link:hover .project-card__shadow {
      opacity: 1;
    }

    /* The other projects fall back to 50% opacity while one is hovered */
    .marquee:has(.project-card__link:hover) .project-card:not(:hover),
    .projects-grid:has(.project-card__link:hover) .project-card:not(:hover) {
      opacity: 0.5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card__link:hover img,
    .project-card__link:hover .project-card__video {
      transform: none;
    }
  }
</style>
